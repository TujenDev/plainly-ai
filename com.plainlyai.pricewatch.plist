<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.plainlyai.pricewatch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/varga/Desktop/Projects/plainly-ai/pricewatch.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/varga/Desktop/Projects/plainly-ai</string>

  <!-- 09:15 daily. launchd runs a missed calendar job once after wake, which
       cron does not, so a closed laptop delays the check rather than skipping
       it. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>15</integer>
  </dict>

  <!-- Off at load, so installing this does not fire it immediately. Kick the
       first run by hand with: launchctl kickstart -k gui/$(id -u)/com.plainlyai.pricewatch -->
  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <!-- The job's own plumbing, separate from the watcher's log at
       ~/Library/Logs/plainlyai-pricewatch.log. This one is for when the agent
       itself misbehaves. -->
  <key>StandardOutPath</key>
  <string>/Users/varga/Library/Logs/plainlyai-pricewatch.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/varga/Library/Logs/plainlyai-pricewatch.launchd.log</string>
</dict>
</plist>
